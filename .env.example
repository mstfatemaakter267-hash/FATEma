# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Portfolio Integrations (Client-Side Vite Variables)
# Set your GitHub username to fetch live public repository stats in Developer Activity
VITE_GITHUB_USERNAME=""
VITE_GITHUB_URL=""
VITE_LINKEDIN_URL=""

# Optional EmailJS configuration for live contact form delivery
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
